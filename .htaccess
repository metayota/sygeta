#AuthType Basic
#AuthName "Restricted Area"
#AuthUserFile /var/www/web670/html/.passwd
#Require valid-user

RewriteEngine On
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]


# Protect .git directory
RedirectMatch 404 /\.git

<IfModule mod_expires.c>
    ExpiresActive On

    # 1 Woche Cache-Dauer
    ExpiresByType image/svg+xml "access plus 1 week"
    ExpiresByType image/png "access plus 1 week"
    ExpiresByType image/webp "access plus 1 week"
    ExpiresByType image/avif "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 week"
    ExpiresByType image/jpg "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(svg|png|webp|avif|jpe?g)$">
        Header set Cache-Control "public, max-age=604800, immutable"
        Header set Pragma "cache"
        Header unset ETag
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    # Wichtig: "always" damit Header auch bei Errors gesetzt werden
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PATCH, OPTIONS, PUT, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept"
    Header always set Access-Control-Max-Age "3600"
    
    # KEIN Credentials bei "*" Origin!
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # OPTIONS sofort mit 204 beantworten (ohne weitere Verarbeitung)
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [R=204,L]
</IfModule>


RewriteEngine on

RewriteRule ^mail/config-v1\.1\.xml$ /call/mail-autoconfig/config.xml [L,QSA]
RewriteRule ^\.well-known/autoconfig/mail/config-v1\.1\.xml$ /call/mail-autoconfig/config.xml [L,QSA]
RewriteRule ^autodiscover/autodiscover\.xml$ /call/mail-autoconfig/autodiscover.xml [L,QSA]

RewriteRule ^s/([a-z0-9]{8})$ /call/shortlink/redirect?code=$1 [L]
RewriteRule ^go/([A-Za-z0-9]+)$ /scripts/track-link/track-link.php?t=$1 [L,QSA]
RewriteRule ^([a-z]{2})/(.*)$ /$2?language=$1 [QSA]

RewriteRule ^photocard/(.*)/(.*)$ /scripts/image.resize/image.resize.php?w=800&h=450&crop=true&src=/uploads/$1/$2&format=webp [B,L]
RewriteRule ^small-square/(.*)/(.*)$ /scripts/image.resize/image.resize.php?w=150&h=150&crop=true&src=/uploads/$1/$2&format=webp [B,L]

RewriteRule ^framework.js$ /resource/framework.javascript
RewriteRule ^(|contact|account|register|login|company)$ /call/index/static_index
RewriteRule ^page/(.*)$ /call/index/static_index?resource=$1
RewriteRule ^(.*)\.html$ /call/index/static_index?resource=$1
RewriteRule ^robots.txt$ /resource/robots.txt.text [L]
RewriteRule ^sitemap.xml$ /call/sitemap
RewriteRule ^resource/(.*?)/(.*?)$ /scripts/metayota/resource.php?name=$1&item=$2 [L,QSA]
RewriteRule ^resource/(.*?)\.json$ /scripts/metayota/resource.php?name=$1&output=json [L,QSA]
RewriteRule ^resource/(.*?)\.([a-z]*)$ /scripts/metayota/resource.php?name=$1&output=implementation&file=$2
RewriteRule ^resource/(.*?)$ /scripts/metayota/resource.php?name=$1
RewriteRule ^sitemap.xml$ /call/sitemap
RewriteRule ^api/v1/([a-zA-Z0-9_-]+)/?$ scripts/api/$1.php [L,QSA]
RewriteRule ^api/v1/([a-zA-Z0-9_-]+)/([0-9]+)/?$ scripts/api/$1.php?id=$2 [L,QSA]

# Neue Regeln für contact-legal-bases
RewriteRule ^api/v1/contacts/([0-9]+)/legal-bases/?$ scripts/api/contact-legal-bases.php?contact_id=$1 [L,QSA]
RewriteRule ^api/v1/contacts/([0-9]+)/legal-bases/([0-9]+)/?$ scripts/api/contact-legal-bases.php?contact_id=$1&id=$2 [L,QSA]

RewriteRule ^call/(.*?)/(.*?)$ /scripts/$1/$2.php [L,QSA]
RewriteRule ^call/(.*?)$ /scripts/$1/$1.php [L,QSA]
RewriteRule ^(images|libs|resource-manager|assets)$ /$1 [L]
RewriteRule ^[a-z-]*$ /call/index/static_index
RewriteRule ^[a-z-]*/[a-z0-9-]*$ /call/index/static_index
RewriteRule ^[a-z0-9-_]*/[a-z0-9-_]*$ /call/index/static_index
RewriteRule ^[a-z0-9-_]*/[a-z0-9-_]*/[a-z0-9-_]*$ /call/index/static_index


